#!/bin/sh
# sdd-gate - impl Step 0 phase gate as a read-only script (spec Revisions 5-7).
# Usage: sdd-gate [--quiet] <epic-id>
#
# Exits 0 iff the feature epic is ready for /sdd:impl:
#   - the epic is in-progress;
#   - all three phase beans (exact "Phase - <name>" titles + the `phase` tag)
#     exist as its children and are completed;
#   - the requirements and design phase beans carry the `validated` tag and
#     their LATEST `Doc-hash: <sha256>` line equals the current
#     `shasum -a 256` of the respective document;
#   - the task queue is runnable SOMEWHERE IN THE EPIC'S BEAN TREE (task
#     beans may nest: major -> sub-task -> ...): at least one todo or
#     in-progress non-phase descendant, OR every non-phase descendant
#     completed/scrapped (a finished feature: exit 0 with a "feature
#     finished" note); with no task beans at all it fails.
# On failure: one-line diagnosis (gate, fix command) on stderr, exit 1.
# --quiet suppresses the success/finished note on stdout (exit code only).
# Read-only: uses the beans CLI and shasum only; changes nothing.
set -eu

. "$(dirname "$0")/_sdd-lib.sh"

quiet=0
epic=""
for arg in "$@"; do
    case $arg in
        --quiet) quiet=1 ;;
        -h|--help)
            echo "usage: sdd-gate [--quiet] <epic-id> - exit 0 iff the feature is ready for /sdd:impl; on failure prints a one-line diagnosis with the fixing command on stderr (exit 1). Read-only."
            exit 0
            ;;
        -*)
            echo "sdd-gate: unknown option: $arg" >&2
            exit 2
            ;;
        *)
            if [ -n "$epic" ]; then
                echo "sdd-gate: exactly one epic id is required" >&2
                exit 2
            fi
            epic=$arg
            ;;
    esac
done
if [ -z "$epic" ]; then
    echo "usage: sdd-gate [--quiet] <epic-id>" >&2
    exit 2
fi

die() {
    echo "sdd-gate: $1" >&2
    exit 1
}

# --- epic: exists, in-progress, records its spec path -----------------------
epic_json=$(sdd_bean_query "$epic" "status body")
case $epic_json in
    *'"bean": null'*) die "epic $epic not found - check the id (beans show)" ;;
esac

epic_status=$(sdd_bean_field "$epic_json" "status")
[ "$epic_status" = in-progress ] ||
    die "gate epic-status: epic $epic is '$epic_status', not in-progress - resolve the feature state first"

spec_dir=$(sdd_epic_spec_dir "$epic")
[ -n "$spec_dir" ] ||
    die "gate spec-path: the epic body carries no 'Spec path:' line - re-run /sdd:spec-init (heal)"
spec_dir=${spec_dir%/}

# --- children: the three phase beans ------------------------------------------
children=$(sdd_children_records "$epic")
sdd_find_phases <<EOF
$children
EOF

[ -n "$PHASE_REQ" ] || die "gate phases: 'Phase — requirements' bean missing under $epic - run /sdd:spec-init (heal)"
[ -n "$PHASE_DES" ] || die "gate phases: 'Phase — design' bean missing under $epic - run /sdd:spec-init (heal)"
[ -n "$PHASE_TSK" ] || die "gate phases: 'Phase — tasks' bean missing under $epic - run /sdd:spec-init (heal)"

[ "$PHASE_REQ_STATUS" = completed ] ||
    die "gate phase-completed: 'Phase — requirements' is '$PHASE_REQ_STATUS' - run /sdd:spec-requirements"
[ "$PHASE_DES_STATUS" = completed ] ||
    die "gate phase-completed: 'Phase — design' is '$PHASE_DES_STATUS' - run /sdd:spec-design"
[ "$PHASE_TSK_STATUS" = completed ] ||
    die "gate phase-completed: 'Phase — tasks' is '$PHASE_TSK_STATUS' - run /sdd:spec-tasks"

case ",$PHASE_REQ_TAGS," in
    *,validated,*) ;;
    *) die "gate validated: 'Phase — requirements' lacks the 'validated' tag - re-run /sdd:spec-requirements" ;;
esac
case ",$PHASE_DES_TAGS," in
    *,validated,*) ;;
    *) die "gate validated: 'Phase — design' lacks the 'validated' tag - re-run /sdd:spec-design" ;;
esac

# --- freshness: latest Doc-hash per phase vs current document hash -----------
for phase_check in "$PHASE_REQ:requirements.md:requirements" "$PHASE_DES:design.md:design"; do
    phase_id=${phase_check%%:*}
    rest=${phase_check#*:}
    doc_name=${rest%%:*}
    phase_label=${rest##*:}
    fresh_diag=$(sdd_check_doc_fresh "$phase_id" "$spec_dir" "$doc_name") || {
        case $fresh_diag in
            nodoc)  die "gate freshness: $spec_dir/$doc_name is missing on disk - restore it or re-run /sdd:spec-$phase_label" ;;
            nohash) die "gate doc-hash: 'Phase — $phase_label' carries no Doc-hash: line - re-run /sdd:spec-$phase_label" ;;
            stale)  die "gate freshness: $doc_name changed after its validation (hash mismatch) - re-run /sdd:spec-$phase_label" ;;
        esac
    }
done

# --- queue readiness: the task tree under the epic ----------------------------
# desc record: id <TAB> parentId <TAB> status <TAB> tags <TAB> title
desc=$(sdd_descendants_records "$epic")
all_tasks=$(printf '%s\n' "$desc" | awk -F'\t' '$4 !~ /(^|,)phase(,|$)/ { c++ } END { print c + 0 }')
runnable=$(printf '%s\n' "$desc" | awk -F'\t' '$4 !~ /(^|,)phase(,|$)/ && ($3 == "todo" || $3 == "in-progress") { c++ } END { print c + 0 }')

[ "$runnable" -ge 1 ] || {
    [ "$all_tasks" -ge 1 ] ||
        die "gate tasks: no task beans under $epic - promote the plan via /sdd:spec-tasks"
    # nothing todo/in-progress but task beans exist: all completed/scrapped
    # (or drafts - which the promote gate owns, not impl)
    drafts=$(printf '%s\n' "$desc" | awk -F'\t' '$4 !~ /(^|,)phase(,|$)/ && $3 == "draft" { c++ } END { print c + 0 }')
    if [ "$drafts" -ge 1 ]; then
        die "gate tasks: $drafts draft task bean(s) not promoted - approve the plan via /sdd:spec-tasks"
    fi
    [ "$quiet" = 1 ] || echo "feature finished — all tasks completed/scrapped"
    exit 0
}

[ "$quiet" = 1 ] || echo "GATE PASS: $epic is ready for /sdd:impl ($spec_dir)"
exit 0
