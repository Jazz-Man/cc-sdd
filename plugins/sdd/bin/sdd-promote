#!/bin/sh
# sdd-promote - draft->todo promotion for task beans (spec Revision 5).
# Usage: sdd-promote <epic-id> --all | <bean-id>...
#
# --all promotes every draft DESCENDANT of the epic except the phase beans
# (the task plan is a tree: major -> sub-task -> ...; leaves and containers
# alike); otherwise each named bean is promoted after verification that it
# is a draft descendant of the epic (phase beans and anything else are
# refused with a stderr note). Prints one promoted id per line on stdout.
# --all with descendants present but zero parseable records warns and exits
# 1 (drift guard - the parser is shared across bin/ via _sdd-lib.sh).
# The only write helper of the sdd bin/ set: writes are strictly
# `beans update <id> -s todo` - statuses change via the CLI only.
set -eu

. "$(dirname "$0")/_sdd-lib.sh"

usage() {
    echo "usage: sdd-promote <epic-id> --all | <bean-id>..." >&2
    exit 2
}

epic_id=""
all=0
ids=""
for arg in "$@"; do
    case $arg in
        --all) all=1 ;;
        -h|--help)
            echo "usage: sdd-promote <epic-id> --all | <bean-id>... - promote draft task beans (any depth in the epic's tree) to todo (spec Revision 5 approve gate); prints each promoted id. --all takes every draft descendant except phase beans."
            exit 0
            ;;
        -*) usage ;;
        *)
            if [ -z "$epic_id" ]; then
                epic_id=$arg
            else
                ids="$ids $arg"
            fi
            ;;
    esac
done
[ -n "$epic_id" ] || usage
if [ "$all" = 1 ] && [ -n "$ids" ]; then
    echo "sdd-promote: --all and explicit ids are mutually exclusive" >&2
    exit 2
fi

epic_json=$(sdd_bean_query "$epic_id" "status")
case $epic_json in
    *'"bean": null'*)
        echo "sdd-promote: epic $epic_id not found - check the id (beans show)" >&2
        exit 1
        ;;
esac

# desc record: id <TAB> parentId <TAB> status <TAB> tags <TAB> title
desc=$(sdd_descendants_records "$epic_id")

if [ "$all" = 1 ]; then
    # Drift guard: children exist in the raw JSON but zero records parsed -
    # the beans output shape changed under the shared parser; refuse rather
    # than report success while promoting nothing.
    if [ -z "$desc" ]; then
        raw_children=$(sdd_bean_query "$epic_id" "children { id }")
        case $raw_children in
            *'"id":'*)
                echo "sdd-promote: epic $epic_id has children but none parsed - beans output drift? (parser shared via bin/_sdd-lib.sh)" >&2
                exit 1
                ;;
        esac
        exit 0
    fi
    printf '%s\n' "$desc" | awk -F'\t' '$4 !~ /(^|,)phase(,|$)/ && $3 == "draft" { print $1 }' |
    while IFS= read -r cid; do
        beans update "$cid" -s todo >/dev/null
        printf '%s\n' "$cid"
    done
    exit 0
fi

[ -n "$ids" ] || usage

# is_descendant <bean-id> - walk the parent chain up to the epic (max 16 hops).
is_descendant() {
    _d_cur=$1
    _d_hops=0
    while [ -n "$_d_cur" ] && [ "$_d_hops" -lt 16 ]; do
        [ "$_d_cur" = "$epic_id" ] && return 0
        _d_json=$(sdd_bean_query "$_d_cur" "parentId")
        _d_cur=$(printf '%s\n' "$_d_json" | sed -n 's/^ *"parentId": "\(.*\)",*$/\1/p' | head -n 1)
        _d_hops=$((_d_hops + 1))
    done
    return 1
}

rc=0
for task_id in $ids; do
    bean_json=$(sdd_bean_query "$task_id" "parentId status tags")
    bean_status=$(sdd_bean_field "$bean_json" "status")
    bean_tags=$(printf '%s\n' "$bean_json" | sed -n 's/^ *"tags": \[\(.*\)\][, ]*$/\1/p' | tr -d '"')
    if [ -z "$bean_status" ]; then
        echo "sdd-promote: skip $task_id - no such bean" >&2
        rc=1
        continue
    fi
    if ! is_descendant "$task_id"; then
        echo "sdd-promote: skip $task_id - not a descendant of $epic_id" >&2
        rc=1
        continue
    fi
    if [ "$bean_status" != draft ]; then
        echo "sdd-promote: skip $task_id - status is '$bean_status', not draft" >&2
        rc=1
        continue
    fi
    case ",$bean_tags," in
        *,phase,*)
            echo "sdd-promote: skip $task_id - phase bean (never promoted here)" >&2
            rc=1
            continue
            ;;
    esac
    beans update "$task_id" -s todo >/dev/null
    printf '%s\n' "$task_id"
done
exit $rc
