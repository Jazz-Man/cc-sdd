{
  "hooks": {
    "PreCompact": [
      { "hooks": [{ "command": "beans prime", "type": "command" }] }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT:?unset}/hooks/sdd-skill-gate.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Skill"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT:?unset}/hooks/sdd-write-guard.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "if [ ! -f \"$CLAUDE_PROJECT_DIR/.claude/rules/sdd.md\" ]; then cat \"${CLAUDE_PLUGIN_ROOT:?unset}/assets/workflow-map.md\"; fi",
            "type": "command"
          }
        ],
        "matcher": "startup|clear|compact"
      },
      { "hooks": [{ "command": "beans prime", "type": "command" }] }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT:?unset}/hooks/sdd-skill-gate.sh\"",
            "type": "command"
          }
        ],
        "matcher": "sdd"
      }
    ]
  }
}
