{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    },
    "globals": ["Bun"]
  },

  "linter": {
    "domains": {
      "project": "all",
      "test": "all",
      "types": "all"
    },
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveLinesPerFunction": "error"
      },
      "correctness": {
        "noNodejsModules": "off",
        "noUndeclaredVariables": {
          "level": "on",
          "options": {
            "checkTypes": true
          }
        },
        "noUnknownFunction": "error",
        "noUnusedVariables": "error",
        "useQwikValidLexicalScope": "off"
      },
      "performance": {
        "noBarrelFile": "error",
        "noNamespaceImport": "off",
        "noReExportAll": "error",
        "useTopLevelRegex": "error"
      },
      "preset": "all",
      "style": {
        "noExcessiveLinesPerFile": "error",
        "noMagicNumbers": "off",
        "noTernary": "error",
        "useBlockStatements": "error",
        "useExportsLast": "error",
        "useNamingConvention": "off"
      },
      "suspicious": {
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "assist": {
        "enabled": false
      },
      "includes": ["packages/cli-hook/tests/fixtures/**"],
      "linter": {
        "enabled": false
      }
    }
  ],
  "root": true,
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
