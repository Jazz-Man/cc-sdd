{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    },
    "globals": ["Bun"]
  },

  "linter": {
    "domains": {
      "project": "all",
      "test": "all",
      "types": "all"
    },
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "error"
      },
      "correctness": {
        "noNodejsModules": "off",
        "noUndeclaredVariables": {
          "level": "on",
          "options": {
            "checkTypes": true
          }
        },
        "useQwikValidLexicalScope": "off"
      },
      "performance": {
        "noBarrelFile": "error",
        "noNamespaceImport": "off"
      },
      "preset": "all",
      "style": {
        "noMagicNumbers": "off",
        "useBlockStatements": "error",
        "useExportsLast": "error",
        "useNamingConvention": {
          "level": "on",
          "options": {
            "conventions": [
              {
                "match": "(?:hook_event_name|tool_input|tool_name|cache_control)|(.+)",
                "selector": {
                  "kind": "objectLiteralProperty"
                }
              },
              {
                "formats": ["CONSTANT_CASE", "camelCase"],
                "selector": {
                  "kind": "objectLiteralProperty"
                }
              }
            ]
          }
        }
      },
      "suspicious": {
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/skill-builder/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["vitest.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ],
  "root": true,
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
